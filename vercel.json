{
  "rewrites": [
    {
      "source": "/api/:path((?!trip-access$|recovery-account$|trip-notifications$).*)",
      "destination": "https://pronti-via-k7es.netlify.app/api/:path"
    },
    {
      "source": "/invito",
      "destination": "https://pronti-via-k7es.netlify.app/invito"
    },
    {
      "source": "/invito/:id*",
      "destination": "https://pronti-via-k7es.netlify.app/invito/:id*"
    },
    {
      "source": "/((?!assets/|vendor/|api/|invito/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
