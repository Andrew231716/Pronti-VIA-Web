{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://cvdlzwralgtapsigyuko.supabase.co/functions/v1/pronti-via/:path*"
    },
    {
      "source": "/((?!assets/|vendor/|api/|.*\\..*).*)",
